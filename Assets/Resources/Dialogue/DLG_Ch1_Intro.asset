  id: DLG_Ch1_Intro
  lines:
  - speaker: "\uB098"
    text: "\uBC24\uC758 \uC6B0\uBB3C\uC740 \uC5B4\uB9B4 \uC801 \uAE30\uC5B5\uACFC
      \uB2E4\uB974\uAC8C \uAE4A\uACE0 \uB0AF\uC124\uC5C8\uB2E4."
    seconds: 3
  - speaker: "\uCEA0\uCF54\uB354"
    text: "LCD \uD654\uBA74 \uC548\uCABD\uC5D0\uB9CC, \uBB3C\uC18D\uC5D0\uC11C \uC62C\uB824\uB2E4\uBCF4\uB294
      \uC5BC\uAD74\uC774 \uBE44\uCCE4\uB2E4."
    seconds: 3.4
  - speaker: "\uB098"
    text: "\uD654\uBA74\uC744 \uB044\uC790 \uC190\uAC00\uB77D\uC774 \uC190\uBAA9\uC744
      \uC7A1\uC544\uB2F9\uACBC\uB2E4. \uB179\uD654 \uC2DC\uAC01\uC740 \uAC70\uAFB8\uB85C
      \uD750\uB974\uAE30 \uC2DC\uC791\uD588\uB2E4."
    seconds: 4
